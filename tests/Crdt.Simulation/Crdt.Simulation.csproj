<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The scenario generator, shared.

    PROJECT_SPEC.md §9's corpus is generated by this generator and replayed by
    both implementations, so it has to be reachable from both the property
    tests (xunit v2, which Stryker drives) and the conformance runner (xunit.v3,
    which is an executable). A second generator written for the second consumer
    is the §13.11 shape — two implementations of one idea, drifting, with
    nothing comparing them.

    Not a test project: it contains no assertions and asserts nothing. It
    produces scenarios; what they mean is decided by whoever replays them.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Crdt.Core/Crdt.Core.csproj" />
  </ItemGroup>

</Project>
