{
  "name": "collaborative-editor-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --build && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:interop": "vitest run --config vitest.interop.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:walk": "vitest run --config vitest.walk.config.ts"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.11",
    "@microsoft/signalr-protocol-msgpack": "^10.0.11",
    "oidc-client-ts": "^3.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "30.0.1",
    "playwright": "^1.62.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
