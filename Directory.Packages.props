<Project>
  <!-- Central package management. Versions live here only; project files
       reference packages without a Version attribute. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Testing">
    <!-- Two test stacks on purpose; AGENTS.md explains which is which.
         Editor.Api.Tests and Conformance run on xunit.v3 under
         Microsoft.Testing.Platform, which is what .NET 10 expects. -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <!-- Crdt.Core.Tests runs on xunit v2 under VSTest, because Stryker drives
         VSTest and does not support Microsoft.Testing.Platform
         (stryker-net#3094). Mutation score is the only check on Crdt.Core that
         is not self-referential, so the runner follows the tool. -->
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
  </ItemGroup>
  <ItemGroup Label="Persistence">
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <!-- Pinned so the provider's transitive EF Core (10.0.4) does not collide
         with the one Design brings. Transitive pinning is on, so naming them
         here settles it for every project. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup Label="Transport and auth">
    <!-- Approved for Phase 3 (PROJECT_SPEC.md §7, §8). JwtBearer validates the
         OIDC tokens; the Redis backplane fans SignalR out across instances so
         that no session is sticky; StackExchange.Redis backs the connect
         tickets and the role cache. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.11" />
    <!-- Framing only (§6, §13.13a). The hub payload stays an opaque byte string
         in §6's format; MessagePack's object model is deliberately unused. -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.11" />
    <PackageVersion Include="StackExchange.Redis" Version="2.9.38" />
  </ItemGroup>
  <ItemGroup Label="Integration testing">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <!-- Drives the hub the way a browser does, so the connect-ticket handshake
         and the hub's error codes are exercised over a real transport. -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.14.0" />
  </ItemGroup>
</Project>