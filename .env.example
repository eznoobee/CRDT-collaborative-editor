# Copy to .env and fill in. .env is gitignored and must never be committed
# (PROJECT_SPEC.md §7: nothing but non-secret defaults in source control).
#
# Generate a password with:  openssl rand -base64 24

POSTGRES_DB=editor
POSTGRES_USER=editor
POSTGRES_PASSWORD=

# Host port the reverse proxy is published on. The API's own port is not
# published at all (PROJECT_SPEC.md §4): a plaintext route past the TLS
# termination is a control that exists and does not apply.
HTTPS_PORT=8443

# TLS, terminating at the proxy. No defaults, for the same reason the password
# has none — and BLANK rather than pre-filled, which is the difference that
# matters.
#
# These used to ship as `./deploy/tls/cert.pem` and `./deploy/tls/key.pem`. That
# reads like a helpful default and is a trap: `deploy/tls/` is gitignored, so in
# a fresh clone those files do not exist, and copying this file unchanged gives
# you a `.env` that LOOKS complete. The `${VAR:?}` guard in docker-compose.yml
# does not catch it, because the variable is set — it is the path that is empty.
# Docker then creates a DIRECTORY at the missing path, mounts it, and the first
# thing to read it dies with EISDIR several layers from the cause (§13.69).
#
# Blank, the guard fires at `docker compose up` with a message naming the script
# that makes one. Run it first, then paste what it prints:
#
#   ./scripts/dev-cert.sh deploy/tls
#
TLS_CERT_FILE=
TLS_KEY_FILE=

# The Docker network the proxy is on, so the API honours X-Forwarded-Proto from
# it and from nothing else.
PROXY_ADDRESS=172.16.0.0/12

# The OIDC provider. No defaults anywhere: the API refuses to start without
# these (PROJECT_SPEC.md §7), because an issuer that falls back to a
# convenient value is a deployment that authenticates against the wrong one.
#
# FOR A REAL DEPLOYMENT, fill these in from your provider and ignore the block
# below.
#
# FOR LOCAL DEVELOPMENT with no provider to hand, uncomment the two lines under
# "local development issuer" instead, and start the stack with the extra overlay
# `-f deploy/docker-compose.dev-oidc.yml`. The README's "Running it locally with
# no identity provider" section has the commands and the one /etc/hosts line
# that makes it work. That overlay is local-only: it is a separate file, and not
# in the default compose, precisely so that this value cannot quietly become
# "whatever was convenient".
OIDC_ISSUER=
OIDC_AUDIENCE=editor-api
OIDC_METADATA_ADDRESS=

# --- local development issuer (deploy/docker-compose.dev-oidc.yml) ------------
#
# NEVER set these against anything you did not start yourself. This issuer mints
# a valid token for any account it is asked for, with no password: it is an
# identity provider with authentication removed, which is fine on a laptop and
# is a total compromise anywhere reachable.
#
# Both values use the SAME host, `editor-oidc`, and that is the whole trick. An
# OIDC issuer is an absolute URL that the browser, the API and the token's `iss`
# claim must agree on exactly, and the metadata document's `jwks_uri` is built
# from it — so `localhost` cannot be used: inside the api container it is the api
# container, and the API would fetch signing keys from itself.
#
#   OIDC_ISSUER=https://editor-oidc:9443
#   OIDC_METADATA_ADDRESS=https://editor-oidc:9443/.well-known/openid-configuration
#
# Accounts the sign-in chooser offers. Two, so that two browser profiles can
# demonstrate two people editing one document.
#   DEV_OIDC_ACCOUNTS=alice,bob

# The public client id the browser authenticates as. Not a secret — a browser
# cannot keep one, which is why §7 requires PKCE — but it has no default, so a
# stack meant to serve the application fails rather than serving one that
# cannot log in.
OIDC_CLIENT_ID=editor-spa

# Redis, holding connect tickets, the role cache and the SignalR backplane.
REDIS_CONFIGURATION=redis:6379
